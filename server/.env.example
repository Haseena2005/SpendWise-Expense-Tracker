# ========================================================
# SpendWise Server Environment Variables
# ========================================================

# Application Port (Render sets process.env.PORT automatically)
PORT=5000

# Environment Mode: 'development' or 'production'
NODE_ENV=development

# MongoDB Connection String:
# For Local: mongodb://127.0.0.1:27017/spendwise
# For Production (MongoDB Atlas):
# mongodb+srv://<username>:<password>@cluster0.eqlkinl.mongodb.net/spendwise?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/spendwise

# Frontend Client URL for CORS:
# For Local: http://localhost:5173
# For Production: https://your-spendwise-frontend.vercel.app (comma-separated if multiple)
CLIENT_URL=http://localhost:5173

# Set to 'true' only for local memory testing without MongoDB installed;
# MUST be 'false' in production with MongoDB Atlas
USE_MEMORY_DB=false

# JSON Web Token Authentication Secret (generate a strong 32+ character random key for production)
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d
